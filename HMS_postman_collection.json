{
  "info": {
    "name": "HMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/HMS/backend/public/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@hms.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login.php",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/list.php",
              "host": ["{{baseUrl}}"],
              "path": ["users", "list.php"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Abebe Kebede\",\n  \"email\": \"abebe@hms.com\",\n  \"password\": \"secret\",\n  \"role\": \"Doctor\",\n  \"phone\": \"0911223344\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/create.php",
              "host": ["{{baseUrl}}"],
              "path": ["users", "create.php"]
            }
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"is_active\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/toggle-status.php",
              "host": ["{{baseUrl}}"],
              "path": ["users", "toggle-status.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List Patients",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/list.php",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "list.php"]
            }
          }
        },
        {
          "name": "Patient Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/detail.php?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "detail.php"],
              "query": [
                { "key": "id", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Sara\",\n  \"last_name\": \"Tadesse\",\n  \"age\": 28,\n  \"gender\": \"Female\",\n  \"phone\": \"0911223344\",\n  \"address\": \"Addis Ababa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients/register.php",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "register.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 1,\n  \"doctor_id\": 2,\n  \"appointment_date\": \"2026-05-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/book.php",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "book.php"]
            }
          }
        },
        {
          "name": "Doctor Queue",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/queue.php?doctor_id=2",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "queue.php"],
              "query": [
                { "key": "doctor_id", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_id\": 10,\n  \"status\": \"In-Consultation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/update-status.php",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "update-status.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Consultations",
      "item": [
        {
          "name": "Submit Consultation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_id\": 10,\n  \"patient_id\": 1,\n  \"symptoms\": \"Fever, cough\",\n  \"diagnosis\": \"Flu\",\n  \"prescription\": \"Paracetamol 500mg\",\n  \"notes\": \"Rest for 3 days\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/consultations/submit.php",
              "host": ["{{baseUrl}}"],
              "path": ["consultations", "submit.php"]
            }
          }
        },
        {
          "name": "Consultation History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/consultations/history.php?patient_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["consultations", "history.php"],
              "query": [
                { "key": "patient_id", "value": "1" }
              ]
            }
          }
        }
      ]
    }
  ]
}